E_needvga       db 'Brak VGA? Užyj starszej wersji CTMOUSE dla obsĺugi EGA RIL',nl,eos
E_error         db nl,'Bĺćd: niepoprawn',eos
E_option	db 'a opcja',eos
E_argument	db 'y argument',eos
E_help          db 5,nl,'Pomoc uzyskasz podajćc /? w wierszu poleceĄ',eos

E_mousepresent  db 5,'Usĺugi myszy sć juž dostĹpne',eos
E_notfound      db 5,'Bĺćd: nie znaleziono urzćdzenia',eos
;;+E_noIRQ      db 5,'Bĺćd: nie wykryto linii IRQ',eos

E_nocute        db 1,'Sterownik CuteMouse nie zostaĺ zainstalowany!',eos
E_notunload     db 2,'Nie mogĹ odinstalowaŹ sterownika: zmienione wektory przerwaĄ...',eos
S_unloaded      db 0,'Sterownik odinstalowany...',eos

S_reset         db 'CzĹ×Ź rezydentna ustawiona na ',eos
S_installed	db 'Zainstalowany na: ',eos
S_atPS2		db 'PS/2',eos
S_atCOM		db 'COM'
com_port	db ?,' ('
S_atIO		db '0000h/IRQ'
IRQno		db ?
S_in            db '), protokóĺ ',eos
S_inMSYS	db 'Mouse Systems',eos
S_inMS		db 'Microsoft',eos
S_inLT		db 'Logitech',eos
S_wheel         db nl,9,9,'(obsĺuga rolki wĺćczona)'
S_CRLF		db nl,eos

Copyright	db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax		label byte
    db 0,'Opcje:',nl
    db '  /P	   - wymusza tryb PS/2',nl
    db '  /S[c[i]] - wymusza užycie portu szeregowego COM nr c (1-4) na przerwaniu',nl
    db '	     i (1-7)',nl
;;+ db '  /S$a[,i] - wymusza užycie portu szeregowego pod adresem a (szesnastkowo)',nl
;;+ db '	     na przerwaniu i (1-7)',nl
    db '  /O       - umožliwia wykrycie kóĺka PS2 i USB BIOS (može siĹ zawiesiŹ)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - nie próbuje trybu Mouse Systems dla urzćdzeĄ nie-PnP',nl,nl
    db '  /M       - próbuje *dawny* Mouse Systems / Genius dla myszy nie-PnP',nl,nl
    db '  /V       - odwraca kolejno×Ź: szuka najpierw na COM, potem na PS/2',nl
    db '  /3       - wymusza tryb 3-przyciskowy (tylko dla myszy Microsoft i PS/2)',nl
    db '  /R[h[v]] - rozdzielczo×Ź pozioma/pionowa (h,v=0-9; brak opcji R, brak',nl
    db '	     argumentów lub podanie 0 oznacza auto resolution; brak drugiego',nl
    db '             argumentu oznacza takć samć warto×Ź jak dla pierwszego argumentu)',nl
    db '  /L       - mysz dla leworĹcznych (domy×lnie dla praworĹcznych)',nl
    db '  /B       - nie uruchamiaj, je×li usĺugi myszy sć juž dostĹpne',nl
    db '  /N       - instaluj, nawet je×li sterownik CuteMouse jest juž zainstalowany',nl
    db '             (užyteczne w .BAT, które deinstalujć CuteMouse na koĄcu)',nl
    db '  /W       - nie instaluj czĹ×ci rezydentnej w UMB',nl
    db '  /U       - odinstaluj sterownik',nl
    db '  /?       - pokaž ten tekst',eos
