; This file is a part of CuteMouse source
; Here are messages in Latvian (for codepage 775)
; Translated by Kristaps Kaupe, Latvia <neons@digital.lv>

E_needvga       db 'No VGA? Use older CTMOUSE if you need EGA RIL support',nl,eos
E_error		db nl,'Kļūda: ',eos
E_option	db 'Nepareiza opcija',eos
E_argument	db 'Invalid option argument',eos
E_help		db 5,nl,'Ievadiet /? komandrindā lai iegūtu palīdzību',eos

E_mousepresent	db 5,'Cits peles draiveris jau ir atmiņā',eos
E_notfound	db 5,'Kļūda: iekārta nav atrasta',eos
;;+E_noIRQ	db 5,'Kļūda: IRQ line not detected',eos

E_nocute	db 1,'CuteMouse draiveris netika ielādēts!',eos
E_notunload	db 2,'Kļūda izlādējot draiveri: daži pārtraukumi aizņemti...',eos
S_unloaded	db 0,'Draiveris veiksmīgi izlādēts...',eos

S_reset		db 'Rezidentā daļa pārlādēta uz ',eos
S_installed	db 'Ielādēts uz ',eos
S_atPS2		db 'PS/2 porta',eos
S_atCOM		db 'COM'
com_port	db ?,' ('
S_atIO		db '0000h/IRQ'
IRQno		db ?
S_in		db ') ',eos
S_inMSYS	db 'Mouse Systems režīmā',eos
S_inMS		db 'Microsoft režīmā',eos
S_inLT		db 'Logitech režīmā',eos
S_wheel		db ' (pele ar ritenīti)'
S_CRLF		db nl,eos

Copyright	db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax		label byte
    db 0,'Opcijas:',nl
    db '  /P	   - PS/2 peles režīms',nl
    db '  /S[c[i]] - seriālās peles režīms uz COM porta c (1-4) ar IRQ līniju i (1-7)',nl
;;+ db '  /S$a[,i] - seriālās peles režīms I/O adresē a (heksadecimālais numurs)',nl
;;+ db '	     ar IRQ līniju i (1-7)',nl
    db '  /O       - enable PS2 and BIOS USB wheel detection (might hang)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y	   - do not try Mouse Systems mode for non-PnP devices',nl,nl
    db '  /M       - try *old* Mouse Systems / Genius for non-PnP mice',nl,nl
    db '  /V	   - apgrieztā meklēšana: meklēt PS/2 pēc seriālās peles',nl
    db '  /3	   - 3 pogu režīms (tikai Microsoft un PS/2 pelēm)',nl
    db '  /R[h[v]] - horizontālā/vertikālā izšķirtspēja (h,v=0-9; ja nav opcijas R,',nl
    db '	     nav argumentu vai arguments pēc R ir 0, tiek lietota automātiska',nl
    db '	     izšķirtspēja, ja trūkst otrā argumentā tam tiek piešķirta tāda',nl
    db '	     pati vērtība kā pirmajam)',nl
    db '  /L	   - kreisās rokas režīms (noklusētais ir labās rokas režīms)',nl
    db '  /B	   - pārtraukt darbu, ja cits peles draiveris jau ir atmiņā',nl
    db '  /N	   - load CuteMouse as new TSR, even if CuteMouse is already loaded',nl
    db '	     (useful for batch files which unload CuteMouse at end)',nl
    db '  /W	   - nelādēt draivera rezidento daļu UMB',nl
    db '  /U	   - izlādēt draiveri',nl
    db '  /?	   - parādīt šo palīdzību',eos
