; Language: Polish, pl, CP852
; created by Google Gemini, 
; please help the FreeDOS group to improve it.
; This file is a part of CuteMouse source
; Here are messages in Polish

E_needvga       db 'Brak VGA? Użyj starszego CTMOUSE, jeśli potrzebujesz obsługi EGA RIL',nl,eos
E_error         db nl,'Błąd: Nieprawidłowa opcja'
E_option    db eos
E_argument  db ' parametr',eos
E_help      db 5,nl,'Wpisz /? w linii poleceń, aby uzyskać pomoc',eos

E_mousepresent  db 5,'Usługi myszy są już dostępne',eos
E_notfound  db 5,'Błąd: nie znaleziono urządzenia',eos
;;+E_noIRQ  db 5,'Błąd: nie wykryto linii IRQ',eos

E_nocute    db 1,'Sterownik CuteMouse nie jest zainstalowany!',eos
E_notunload db 2,'Błąd usuwania: niektóre przerwania zostały przechwycone...',eos
S_unloaded  db 0,'Sterownik pomyślnie usunięty z pamięci...',eos

S_reset     db 'Część rezydentna zresetowana do ',eos
S_installed db 'Zainstalowano na '
S_atPS2     db 'porcie PS/2',eos
S_atCOM     db 'COM'
com_port    db ?,' ('
S_atIO      db '0000h/IRQ'
IRQno       db ?
S_in        db ') w ',eos
S_inMSYS    db 'trybie Mouse Systems',eos
S_inMS      db 'trybie Microsoft',eos
S_inLT      db 'trybie Logitech',eos
S_wheel     db ' (znaleziono kółko)'
S_CRLF      db nl,eos

Copyright   db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax      label byte
    db 0,nl,'Opcje:',nl
    db '  /V       - odwrócone szukanie: znajdź PS/2 po myszy szeregowej',nl
    db '  /P       - wymuś tryb myszy PS/2, nie sprawdzaj portów szeregowych',nl
    db '  /S[c[i]] - wymuś mysz szeregową na porcie COM c (1-4) z IRQ i (1-7)',nl
    db '  /3       - wymuś tryb 3-przyciskowy, jeśli znaleziono mysz Microsoft/PS2',nl
; Note: /O now acts inverse compared to 2.1 beta 3
    db '  /O       - włącz wykrywanie kółka PS2 i BIOS USB (może zawiesić system)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - nie próbuj trybu Mouse Systems dla urządzeń nie-PnP',nl,nl
    db '  /M       - spróbuj *starego* Mouse Systems/Genius dla myszy nie-PnP',nl,nl
    db '  /R[h[v]] - rozdzielczość poz./pionowa: h,v = 1-9, lub 0 dla auto',nl
    db '         (brak wartości = domyślne: auto dla h, lub "jak h" dla v)',nl
    db '  /L       - zamień lewy i prawy przycisk myszy',nl,nl
;
    db '  /B       - przerwij uruchamianie, jeśli usługi myszy są już załadowane',nl
    db '  /N       - załaduj jako nowy TSR, nawet jeśli sterownik jest już w pamięci',nl
    db '         (przydatne dla plików wsadowych, które na końcu usuwają TSR)',nl
    db '  /W       - nie pozwalaj CuteMouse na przeniesienie się do pamięci UMB',nl
    db '  /U       - odinstaluj sterownik, usuń TSR z pamięci',nl
    db '  /?       - pokaż tę pomoc',eos
