; Language: Lithuanian, lt, CP775
; created by Google Gemini, 
; please help the FreeDOS group to improve it.
; This file is a part of CuteMouse source
; Here are messages in Lithuanian

E_needvga       db 'Nėra VGA? Naudokite senesnę CTMOUSE, jei reikia EGA RIL palaikymo',nl,eos
E_error         db nl,'Klaida: Neteisinga parinktis'
E_option    db eos
E_argument  db ' argumentas',eos
E_help      db 5,nl,'Įveskite /? komandinėje eilutėje pagalbai',eos

E_mousepresent  db 5,'Pelės paslaugos jau paleistos',eos
E_notfound  db 5,'Klaida: įrenginys nerastas',eos
;;+E_noIRQ  db 5,'Klaida: IRQ linija neaptikta',eos

E_nocute    db 1,'CuteMouse tvarkyklė neįdiegta!',eos
E_notunload db 2,'Tvarkyklės iškėlimas nepavyko: perimtos kai kurios pertrauktys...',eos
S_unloaded  db 0,'Tvarkyklė sėkmingai iškelta iš atminties...',eos

S_reset     db 'Rezidentinė dalis atkurta į ',eos
S_installed db 'Įdiegta prie '
S_atPS2     db 'PS/2 prievado',eos
S_atCOM     db 'COM'
com_port    db ?,' ('
S_atIO      db '0000h/IRQ'
IRQno       db ?
S_in        db '), ',eos
S_inMSYS    db 'Mouse Systems režimas',eos
S_inMS      db 'Microsoft režimas',eos
S_inLT      db 'Logitech režimas',eos
S_wheel     db ' (rastas ratukas)'
S_CRLF      db nl,eos

Copyright   db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax      label byte
    db 0,nl,'Parinktys:',nl
    db '  /V       - atvirkštinė paieška: rasti PS/2 po nuosekliosios pelės',nl
    db '  /P       - priverstinis PS/2 pelės režimas, netikrinti nuos. prievadų',nl
    db '  /S[c[i]] - priverstinis nuosekliosios pelės rež. COM c (1-4) su IRQ i (1-7)',nl
    db '  /3       - priverstinis 3-mygtukų rež., jei rasta Microsoft/PS2 pelė',nl
; Note: /O now acts inverse compared to 2.1 beta 3
    db '  /O       - įjungti PS2 ir BIOS USB ratuko aptikimą (gali pakibti)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - nebandyti Mouse Systems režimo ne-PnP įrenginiams',nl,nl
    db '  /M       - bandyti *seną* Mouse Systems/Genius ne-PnP pelėms',nl,nl
    db '  /R[h[v]] - horiz./vertikali skiriamoji geba: h,v = 1-9, 0 - auto',nl
    db '         (be reikšmės = numatytasis: auto skirta h, arba "kaip h" skirta v)',nl
    db '  /L       - sukeisti kairįjį ir dešinįjį pelės mygtukus',nl,nl
;
    db '  /B       - atšaukti paleidimą, jei pelės paslaugos jau veikia',nl
    db '  /N       - įkelti CuteMouse kaip naują TSR, net jei jau įkeltas',nl
    db '         (naudinga paketiniams failams, kurie pabaigoje iškelia CuteMouse)',nl
    db '  /W       - neleisti CuteMouse persikelti į UMB atmintį',nl
    db '  /U       - pašalinti tvarkyklę, iškelti TSR iš atminties',nl
    db '  /?       - rodyti šią pagalbą',eos
