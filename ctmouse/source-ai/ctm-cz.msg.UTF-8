; Language: Czech, cz, CP852
; created by Google Gemini, 
; please help the FreeDOS group to improve it.
; This file is a part of CuteMouse source
; Here are messages in Czech

E_needvga       db 'Chybí VGA? Použijte starší CTMOUSE, pokud potřebujete podporu EGA RIL',nl,eos
E_error         db nl,'Chyba: Neplatná volba'
E_option    db eos
E_argument  db ' argument',eos
E_help      db 5,nl,'Zadejte /? do příkazového řádku pro nápovědu',eos

E_mousepresent  db 5,'Služby myši jsou již zavedeny',eos
E_notfound  db 5,'Chyba: zařízení nenalezeno',eos
;;+E_noIRQ  db 5,'Chyba: linka IRQ nebyla detekována',eos

E_nocute    db 1,'Ovladač CuteMouse není nainstalován!',eos
E_notunload db 2,'Odstranění selhalo: některá přerušení jsou zachycena...',eos
S_unloaded  db 0,'Ovladač byl úspěšně odstraněn z paměti...',eos

S_reset     db 'Rezidentní část resetována na ',eos
S_installed db 'Nainstalováno na '
S_atPS2     db 'PS/2 portu',eos
S_atCOM     db 'COM'
com_port    db ?,' ('
S_atIO      db '0000h/IRQ'
IRQno       db ?
S_in        db ') v ',eos
S_inMSYS    db 'režimu Mouse Systems',eos
S_inMS      db 'režimu Microsoft',eos
S_inLT      db 'režimu Logitech',eos
S_wheel     db ' (kolečko nalezeno)'
S_CRLF      db nl,eos

Copyright   db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax      label byte
    db 0,nl,'Volby:',nl
    db '  /V       - zpětné hledání: najít PS/2 po sériové myši',nl
    db '  /P       - vynutit režim PS/2 myši, netestovat sériové porty',nl
    db '  /S[c[i]] - vynutit sériovou myš na COM c (1-4) s IRQ i (1-7)',nl
    db '  /3       - vynutit 3tlačítkový režim, pokud je nalezena Microsoft/PS2 myš',nl
; Note: /O now acts inverse compared to 2.1 beta 3
    db '  /O       - povolit detekci kolečka pro PS2 a BIOS USB (může zamrznout)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - nezkoušet režim Mouse Systems pro ne-PnP zařízení',nl,nl
    db '  /M       - zkusit *starý* Mouse Systems/Genius pro ne-PnP myši',nl,nl
    db '  /R[h[v]] - horiz./vertikální rozlišení: h,v = 1-9, nebo 0 pro auto',nl
    db '         (bez hodnoty = výchozí: auto pro h, nebo "jako h" pro v)',nl
    db '  /L       - prohodit levé a pravé tlačítko myši',nl,nl
;
    db '  /B       - přerušit spouštění, pokud jsou služby myši již zavedeny',nl
    db '  /N       - zavést CuteMouse jako nové TSR, i když už je zaveden',nl
    db '         (užitečné pro dávkové soubory, které nakonec CuteMouse odstraní)',nl
    db '  /W       - nedovolit ovladači CuteMouse přesun do paměti UMB',nl
    db '  /U       - odinstalovat ovladač, odstranit TSR z paměti',nl
    db '  /?       - zobrazit tuto nápovědu',eos
