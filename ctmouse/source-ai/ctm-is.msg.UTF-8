; Language: Icelandic, is, CP861
; created by Google Gemini, 
; please help the FreeDOS group to improve it.
; This file is a part of CuteMouse source
; Here are messages in Icelandic

E_needvga       db 'Ekkert VGA? Nota eldra CTMOUSE ef þú þarft EGA RIL stuðning',nl,eos
E_error         db nl,'Villa: Ógild valkostur'
E_option    db eos
E_argument  db ' frumbreyta',eos
E_help      db 5,nl,'Sláðu inn /? á skipanalínuna fyrir hjálp',eos

E_mousepresent  db 5,'Músaþjónusta þegar til staðar',eos
E_notfound  db 5,'Villa: Tæki fannst ekki',eos
;;+E_noIRQ  db 5,'Villa: IRQ lína fannst ekki',eos

E_nocute    db 1,'CuteMouse rekill er ekki uppsettur!',eos
E_notunload db 2,'Fjarlæging mistókst: sumar truflanir eru hleraðar...',eos
S_unloaded  db 0,'Rekill var fjarlægður úr minni...',eos

S_reset     db 'Minnisföstum hluta endurstillt á ',eos
S_installed db 'Uppsett á ',eos
S_atPS2     db 'PS/2 tengi',eos
S_atCOM     db 'COM'
com_port    db ?,' ('
S_atIO      db '0000h/IRQ'
IRQno       db ?
S_in        db ') í ',eos
S_inMSYS    db 'Mouse Systems ham',eos
S_inMS      db 'Microsoft ham',eos
S_inLT      db 'Logitech ham',eos
S_wheel     db ' (skrunhjól til staðar)'
S_CRLF      db nl,eos

Copyright   db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax      label byte
    db 0,nl,'Valkostir:',nl
    db '  /V       - Öfug leit: finna PS/2 á eftir raðtengdri mús',nl
    db '  /P       - Þvinga PS/2 ham, ekki prófa raðtengi',nl
    db '  /S[c[i]] - Þvinga raðtengdan ham á COM c (1-4) með IRQ i (1-7)',nl
    db '  /3       - Þvinga 3-hnappa ham ef Microsoft/PS2 mús finnst',nl
; Note: /O now acts inverse compared to 2.1 beta 3
    db '  /O       - Virkja PS2 & BIOS USB hjólleit (gæti frosið)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - Ekki reyna Mouse Systems ham fyrir non-PnP tæki',nl,nl
    db '  /M       - Reyna *gamla* Mouse Systems/Genius fyrir non-PnP',nl,nl
    db '  /R[h[v]] - Lárét/lóðrétt upplausn: h,v = 1-9, eða 0 fyrir sjálfv.',nl
    db '         (Ekkert gildi = sjálfv. fyrir h, eða "sem h" fyrir v)',nl
    db '  /L       - Víxla vinstri og hægri músarhnappi',nl,nl
;
    db '  /B       - Hætta ef músaþjónusta er þegar til staðar',nl
    db '  /N       - Hlaða CuteMouse sem nýtt TSR, jafnvel þótt það sé hlaðið',nl
    db '         (Gagnlegt fyrir runuskrár sem fjarlægja CuteMouse í lokin)',nl
    db '  /W       - Ekki leyfa CuteMouse að færa sig í UMB',nl
    db '  /U       - Fjarlægja rekil, taka TSR úr minni',nl
    db '  /?       - Sýna þessa hjálp',eos
