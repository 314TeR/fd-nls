; Language: Ukrainian, uk, CP1125
; created by Google Gemini, 
; please help the FreeDOS group to improve it.
; This file is a part of CuteMouse source
; Here are messages in Ukrainian

E_needvga       db 'Немає VGA? Викор. старий CTMOUSE для підтримки EGA RIL',nl,eos
E_error         db nl,'Помилка: Недійсний параметр'
E_option    db eos
E_argument  db ' аргумент',eos
E_help      db 5,nl,'Введіть /? у командному рядку для довідки',eos

E_mousepresent  db 5,'Служби миші вже завантажені',eos
E_notfound  db 5,'Помилка: пристрій не знайдено',eos
;;+E_noIRQ  db 5,'Помилка: лінія IRQ не виявлена',eos

E_nocute    db 1,'Драйвер CuteMouse не встановлено!',eos
E_notunload db 2,'Помилка вивантаження: деякі переривання перехоплені...',eos
S_unloaded  db 0,'Драйвер успішно вивантажено...',eos

S_reset     db 'Резидентна частина скинута на ',eos
S_installed db 'Встановлено на '
S_atPS2     db 'порт PS/2',eos
S_atCOM     db 'COM'
com_port    db ?,' ('
S_atIO      db '0000h/IRQ'
IRQno       db ?
S_in        db ') у ',eos
S_inMSYS    db 'режимі Mouse Systems',eos
S_inMS      db 'режимі Microsoft',eos
S_inLT      db 'режимі Logitech',eos
S_wheel     db ' (знайдено коліщатко)'
S_CRLF      db nl,eos

Copyright   db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax      label byte
    db 0,nl,'Параметри:',nl
    db '  /V       - зворотний пошук: шукати PS/2 після COM-миші',nl
    db '  /P       - примусовий режим PS/2, не перевіряти COM-порти',nl
    db '  /S[c[i]] - примусова COM-миша на COM c (1-4) з IRQ i (1-7)',nl
    db '  /3       - прим. режим 3 кнопок, якщо знайдено мишу Microsoft/PS2',nl
; Note: /O now acts inverse compared to 2.1 beta 3
    db '  /O       - увімк. пошук коліщатка для PS2 і BIOS USB (може зависнути)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - не пробувати режим Mouse Systems для не-PnP пристроїв',nl,nl
    db '  /M       - спробувати *старий* Mouse Systems/Genius для не-PnP',nl,nl
    db '  /R[h[v]] - гориз./вертик. розд. здатність: h,v = 1-9, або 0 (авто)',nl
    db '         (без значення = за замовч.: авто для h, або "як h" для v)',nl
    db '  /L       - поміняти місцями ліву та праву кнопки миші',nl,nl
;
    db '  /B       - скасувати запуск, якщо служби миші вже завантажені',nl
    db '  /N       - завантажити CuteMouse як новий TSR, навіть якщо вже завантаж.',nl
    db '         (корисно для bat-файлів, що вивантажують CuteMouse наприкінці)',nl
    db '  /W       - заборонити CuteMouse переміщати себе до UMB',nl
    db '  /U       - видалити драйвер, вивантажити TSR',nl
    db '  /?       - показати цю довідку',eos
