; Language: Serbian, sr, CP855
; created by Google Gemini, 
; please help the FreeDOS group to improve it.
; This file is a part of CuteMouse source
; Here are messages in Serbian

E_needvga       db 'Нема ВГА? Користите старији CTMOUSE за ЕГА РИЛ подршку',nl,eos
E_error         db nl,'Грешка: Неважећа опција'
E_option    db eos
E_argument  db ' аргумент',eos
E_help      db 5,nl,'Унесите /? у командној линији за помоћ',eos

E_mousepresent  db 5,'Услуге миша су већ присутне',eos
E_notfound  db 5,'Грешка: уређај није пронађен',eos
;;+E_noIRQ  db 5,'Грешка: IRQ линија није откривена',eos

E_nocute    db 1,'CuteMouse драјвер није инсталиран!',eos
E_notunload db 2,'Уклањање драјвера није успело: неки прекиди су пресретнути...',eos
S_unloaded  db 0,'Драјвер је успешно уклоњен из меморије...',eos

S_reset     db 'Резидентни део ресетован на ',eos
S_installed db 'Инсталирано на '
S_atPS2     db 'PS/2 порту',eos
S_atCOM     db 'COM'
com_port    db ?,' ('
S_atIO      db '0000h/IRQ'
IRQno       db ?
S_in        db ') у ',eos
S_inMSYS    db 'Mouse Systems режиму',eos
S_inMS      db 'Microsoft режиму',eos
S_inLT      db 'Logitech режиму',eos
S_wheel     db ' (точкић присутан)'
S_CRLF      db nl,eos

Copyright   db nl,'CuteMouse v',CTMRELEASE,' [FreeDOS]',nl,eos
Syntax      label byte
    db 0,nl,'Опције:',nl
    db '  /V       - обрнута претрага: нађи PS/2 после серијског миша',nl
    db '  /P       - форсирај PS/2 режим, не проверавај серијске портове',nl
    db '  /S[c[i]] - форсирај серијски миш на COM c (1-4) са IRQ i (1-7)',nl
    db '  /3       - форсирај режим 3 дугмета ако је нађен Microsoft/PS2 миш',nl
; Note: /O now acts inverse compared to 2.1 beta 3
    db '  /O       - омогући PS2 и BIOS USB детекцију точкића (може да блокира)',nl
; 2008: made /Y (ignore MSys) the default and introduced /M (enable MSys)
;   db '  /Y       - не покушавај Mouse Systems режим за не-PnP уређаје',nl,nl
    db '  /M       - пробај *стари* Mouse Systems/Genius за не-PnP мишеве',nl,nl
    db '  /R[h[v]] - хориз./вертик. резолуција: h,v = 1-9, или 0 за ауто',nl
    db '         (без вредности = подразумевано: ауто за h, или "као h" за v)',nl
    db '  /L       - замени лево и десно дугме миша',nl,nl
;
    db '  /B       - прекини покретање ако су услуге миша већ присутне',nl
    db '  /N       - учитај CuteMouse као нови TSR, чак и ако је већ учитан',nl
    db '         (корисно за бач фајлове који уклањају CuteMouse на крају)',nl
    db '  /W       - не дозволи да CuteMouse премести себе у UMB меморију',nl
    db '  /U       - деинсталирај драјвер, уклони TSR из меморије',nl
    db '  /?       - прикажи ову помоћ',eos
